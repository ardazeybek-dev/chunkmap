# chunkmap configuration — copy to `.env` (git-ignored) and adjust.
# Precedence: defaults < .env < process environment < command-line flags.

# Average FastCDC chunk size (power of two, 256B..4MiB). Smaller = finer
# near-duplicate detection, more memory. min = avg/4, max = avg*8.
CHUNKMAP_AVG_CHUNK=16K

# Worker threads (0 = one per CPU core).
CHUNKMAP_THREADS=0

# Skip files outside this size range.
CHUNKMAP_MIN_FILE_SIZE=1
# CHUNKMAP_MAX_FILE_SIZE=50G

# Comma-separated glob patterns to skip (matched against names, or against
# root-relative paths when the pattern contains a slash).
CHUNKMAP_EXCLUDE=.git,.zig-cache,$RECYCLE.BIN,System Volume Information

# Write reports on every scan (leave empty to disable).
CHUNKMAP_HTML=
CHUNKMAP_JSON=

# Rows per terminal section and near-duplicate threshold (0..1).
CHUNKMAP_TOP=10
CHUNKMAP_SIMILARITY=0.25

# auto | always | never   (NO_COLOR is honoured as well)
CHUNKMAP_COLOR=auto
